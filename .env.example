# Copy to .env and fill in:  cp .env.example .env
# (.env is git-ignored and never pushed.)

# Required for full-brain answers. Get one free at https://build.nvidia.com
NVIDIA_API_KEY=put_your_nvapi_key_here

# Brain model (any OpenAI-compatible model on NVIDIA Build)
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Reply voice for Edge fallback (free; AU bloke while edge is in chain)
TTS_VOICE=en-AU-WilliamMultilingualNeural

# Voice engine: chirp (Google AU, needs GCP below) -> kokoro (local) ->
# edge (free) -> say (offline). Failures fall down automatically.
TTS_BACKEND=chirp
CHIRP_VOICE=en-AU-Chirp-HD-D
KOKORO_VOICE=bm_george
# Google Cloud key (service account JSON, billing enabled on the project):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# Speech-to-text: auto (parakeet v2 if nemo installed, else whisper) |
# parakeet | whisper
STT_BACKEND=auto
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
